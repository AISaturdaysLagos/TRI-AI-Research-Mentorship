# Firebase web config is public. Authorization is enforced by Firestore Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local testing. .env.development sets both for npm run dev.
# GitHub Pages sets VITE_ENABLE_FIXTURES=true and leaves the emulator flag unset,
# so the published demo uses the demo Firebase project.
VITE_ENABLE_FIXTURES=
VITE_USE_EMULATORS=
